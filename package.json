{
  "name": "page-pulse",
  "version": "1.0.0",
  "description": "Production-grade URL audit API built with Express and TypeScript",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\" && tsc && node -e \"require('fs').mkdirSync('dist/public', {recursive: true}); require('fs').copyFileSync('src/public/index.html', 'dist/public/index.html')\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2"
  }
}
